<mxfile host="app.diagrams.net" type="device"><diagram id="d1" name="UC08 – Quản lý mượn/trả sách"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="185.0" y="40.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="a1" value="Thủ thư chọn Quản lý mượn/trả sách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105.0" y="110.0" width="190.0" height="50.0" as="geometry"/></mxCell><mxCell id="a2" value="Hệ thống hiển thị màn hình quản lý" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105.0" y="200.0" width="190.0" height="50.0" as="geometry"/></mxCell><mxCell id="a3" value="Thủ thư nhập mã thẻ hoặc mã phiếu mượn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105.0" y="290.0" width="190.0" height="50.0" as="geometry"/></mxCell><mxCell id="d0" value="Tìm thấy phiếu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200.0" y="380.0" width="130.0" height="64.0" as="geometry"/></mxCell><mxCell id="x0" value="Hệ thống thông báo không tìm thấy phiếu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="484.0" width="190.0" height="50.0" as="geometry"/></mxCell><mxCell id="a4" value="Hệ thống hiển thị thông tin phiếu mượn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fff2cc;strokeC