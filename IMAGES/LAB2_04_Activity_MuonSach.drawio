, trùng đầu sách, tổng số ≤ 3, hẹn trả ≥ ngày mượn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640.0" y="634.0" width="220.0" height="52.0" as="geometry"/></mxCell><mxCell id="d3" value="Hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="675.0" y="728.0" width="150.0" height="64.0" as="geometry"/></mxCell><mxCell id="s4" value="Lưu PhieuMuon + ChiTietPhieuMuon (transaction), giảm SoLuongHienCo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640.0" y="834.0" width="220.0" height="52.0" as="geometry"/></mxCell><mxCell id="s5" value="Thông báo lập phiếu thành công, hiển thị mã phiếu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640.0" y="934.0" width="220.0" height="52.0" as="geometry"/></mxCell><mxCell id="t3" value="Giao sách cho độc giả" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340.0" y="934.0" width="220.0" height="52.0" as="geometry"/></mxCell><mxCell id="a2" value="Nhận sách và phiếu mượn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="934.0" width="220.0" height="52.0" as="geometry"/></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="135.0" y="1040.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=9;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s" target="a1"><mxGeometry relative=